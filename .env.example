# No ANTHROPIC_API_KEY is needed: all Claude calls go through the local
# `claude` CLI in headless mode (claude -p), which uses your existing login.

DB_PATH=./data/opportunities.db
CRON_SCHEDULE=0 8,18 * * *
RESUME_PATH=./resume.pdf

# Alias ("sonnet", "opus", "haiku") or a full model id, passed to `claude --model`.
CLAUDE_MODEL=sonnet

# Path to the claude CLI if it is not on PATH.
CLAUDE_BIN=claude

# Path to a TeX engine if it is not on PATH. Empty means: look for tectonic,
# latexmk, xelatex or pdflatex, in that order.
LATEX_BIN=

# How long a single resume render may take before it is killed.
LATEX_TIMEOUT_SECONDS=120
